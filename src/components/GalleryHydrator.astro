<script>
  type PhotoData = {
    id: string;
    alt: string;
    width: number;
    height: number;
    aspectRatio: number;
    featured?: boolean;
    lqip: string;
    originalExt: string;
    variants: { avif: number[]; webp: number[] };
  };

  const PUBLIC_BASE =
    (document.documentElement.dataset.imgBase ?? 'https://img.asahoo.dev').replace(/\/$/, '');

  const variantUrl = (id: string, w: number, ext: 'avif' | 'webp') =>
    `${PUBLIC_BASE}/variants/${id}/${w}.${ext}`;
  const originalUrl = (p: PhotoData) =>
    `${PUBLIC_BASE}/originals/${p.id}.${p.originalExt}`;
  const fullUrl = (p: PhotoData) => {
    const widths = p.variants.webp;
    const w = widths.includes(1600) ? 1600 : widths[widths.length - 1];
    return variantUrl(p.id, w, 'webp');
  };
  const fallbackSrc = (p: PhotoData) => {
    const widths = p.variants.webp;
    return variantUrl(p.id, widths[0], 'webp');
  };

  function srcset(p: PhotoData, ext: 'avif' | 'webp'): string {
    return p.variants[ext].map((w) => `${variantUrl(p.id, w, ext)} ${w}w`).join(', ');
  }

  // Deterministic hash — must match the server-side version in Gallery.astro.
  function photoHash(id: string): number {
    let h = 5381;
    for (let i = 0; i < id.length; i++) {
      h = ((h << 5) + h + id.charCodeAt(i)) >>> 0;
    }
    return h;
  }
  const isWideId = (id: string) => photoHash(id) % 4 === 0;

  function buildTile(p: PhotoData): HTMLElement {
    const wide = isWideId(p.id) || !!p.featured;
    const pic = document.createElement('picture');
    pic.className = 'gallery-photo' + (wide ? ' gallery-photo--wide' : '');
    pic.dataset.photoId = p.id;
    pic.dataset.photoOriginal = originalUrl(p);
    pic.dataset.photoFull = fullUrl(p);
    pic.dataset.photoAlt = p.alt;
    pic.dataset.photoRatio = String(p.aspectRatio);

    const sizes = wide ? '100vw' : '34vw';

    const sAvif = document.createElement('source');
    sAvif.type = 'image/avif';
    sAvif.srcset = srcset(p, 'avif');
    sAvif.sizes = sizes;
    pic.appendChild(sAvif);

    const sWebp = document.createElement('source');
    sWebp.type = 'image/webp';
    sWebp.srcset = srcset(p, 'webp');
    sWebp.sizes = sizes;
    pic.appendChild(sWebp);

    const img = document.createElement('img');
    img.src = fallbackSrc(p);
    img.alt = p.alt;
    img.width = p.width;
    img.height = p.height;
    img.loading = 'lazy';
    img.decoding = 'async';
    img.style.backgroundImage = `url('${p.lqip}')`;
    img.style.backgroundSize = 'cover';
    pic.appendChild(img);

    return pic;
  }

  // ---- Justified rows layout -------------------------------------------------
  // Photos flow into full-width rows. Within a row every photo shares one
  // height; widths are proportional to aspect ratio (flex-grow), so each row
  // fills the available width exactly — no holes. "Wide" photos get their own
  // row (alone, or paired with one normal photo) so they render larger.

  const gallery = document.querySelector<HTMLElement>('.gallery');
  // Canonical ordered list of tiles; rows are rebuilt from this on every layout.
  let tiles: HTMLElement[] = gallery
    ? Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-photo'))
    : [];

  // Prefer the actually-loaded image's dimensions — the stored metadata can be
  // stale (e.g. EXIF-rotated photos recorded with pre-rotation dimensions), so
  // the loaded image is the source of truth once available.
  const ratioOf = (t: HTMLElement) => {
    const img = t.querySelector('img');
    if (img && img.complete && img.naturalWidth > 0) {
      return img.naturalWidth / img.naturalHeight;
    }
    const r = parseFloat(t.dataset.photoRatio ?? '1.5');
    return r > 0 ? r : 1.5;
  };
  const isWideTile = (t: HTMLElement) => t.classList.contains('gallery-photo--wide');

  function layout() {
    if (!gallery || tiles.length === 0) return;

    const cs = getComputedStyle(gallery);
    const padL = parseFloat(cs.paddingLeft) || 0;
    const padR = parseFloat(cs.paddingRight) || 0;
    const gap = parseFloat(cs.getPropertyValue('--gallery-gap')) || 6;
    const available = gallery.clientWidth - padL - padR;
    if (available <= 0) return;

    const isMobile = window.matchMedia('(max-width: 640px)').matches;
    // Knob controlling photos-per-row: smaller divisor → fewer, larger photos.
    const target = available / (isMobile ? 2.4 : 4.2);

    // A "feature" photo gets its own row (optionally paired with one normal
    // photo) so it renders larger: hash-picked wide photos, and any portrait
    // (aspect ratio < 1), which would otherwise be squeezed short in a normal
    // row. Pairing a portrait with one landscape gives it a tall, prominent slot.
    const isFeature = (t: HTMLElement) => isWideTile(t) || ratioOf(t) < 1;

    // Group tiles into rows.
    const rows: HTMLElement[][] = [];
    let i = 0;
    while (i < tiles.length) {
      if (isFeature(tiles[i])) {
        const row = [tiles[i]];
        i++;
        if (i < tiles.length && !isFeature(tiles[i])) {
          row.push(tiles[i]);
          i++;
        }
        rows.push(row);
      } else {
        // Greedy fill until the row height drops to the target.
        const row: HTMLElement[] = [];
        let sumAR = 0;
        while (i < tiles.length && !isFeature(tiles[i])) {
          row.push(tiles[i]);
          sumAR += ratioOf(tiles[i]);
          i++;
          const h = (available - gap * (row.length - 1)) / sumAR;
          if (h <= target) break;
        }
        rows.push(row);
      }
    }

    // Render rows. Reuses existing tile elements (no image reloads). No height
    // is set: each photo's flex-grow is its aspect ratio, so widths are
    // proportional to aspect ratio and the natural heights (width / ratio) come
    // out equal across the row — no cropping, portraits included.
    const frag = document.createDocumentFragment();
    for (const row of rows) {
      const rowEl = document.createElement('div');
      rowEl.className = 'gallery-row';
      for (const t of row) {
        t.style.flex = `${ratioOf(t)} 1 0`;
        rowEl.appendChild(t);
      }
      frag.appendChild(rowEl);
    }
    gallery.replaceChildren(frag);
    gallery.classList.add('is-justified');
  }

  // Debounced relayout, shared by resize and image-load corrections.
  let layoutTimer: number | undefined;
  function scheduleLayout() {
    window.clearTimeout(layoutTimer);
    layoutTimer = window.setTimeout(layout, 100);
  }

  // Relayout as images finish loading, since their true dimensions (which may
  // differ from the stored metadata) only become known then.
  function watchLoads(ts: HTMLElement[]) {
    for (const t of ts) {
      const img = t.querySelector('img');
      if (img && !img.complete) {
        img.addEventListener('load', scheduleLayout, { once: true });
      }
    }
  }

  // Initial layout + relayout on resize and as images load.
  layout();
  watchLoads(tiles);
  window.addEventListener('resize', scheduleLayout);

  // ---- Infinite scroll -------------------------------------------------------
  const sentinel = document.getElementById('gallery-sentinel');
  let nextUrl: string | null = sentinel?.dataset.next || null;
  let loading = false;

  async function loadNext() {
    if (!nextUrl || loading) return;
    loading = true;
    try {
      const res = await fetch(nextUrl);
      if (!res.ok) {
        loading = false;
        return;
      }
      const data = (await res.json()) as { photos: PhotoData[]; next: string | null };
      const added: HTMLElement[] = [];
      for (const p of data.photos) {
        const tile = buildTile(p);
        tiles.push(tile);
        added.push(tile);
      }
      layout();
      watchLoads(added);
      nextUrl = data.next;
      if (!nextUrl && sentinel) sentinel.remove();
    } catch {
      // ignore
    } finally {
      loading = false;
    }
  }

  if (sentinel && nextUrl && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) loadNext();
      },
      { rootMargin: '600px' }
    );
    io.observe(sentinel);
  } else if (sentinel && !nextUrl) {
    sentinel.remove();
  }

  // ---- Lightbox --------------------------------------------------------------
  const lb = document.getElementById('lightbox');
  const lbImg = lb?.querySelector<HTMLImageElement>('.lightbox-img');
  const lbPrevBtn = lb?.querySelector<HTMLButtonElement>('[data-lb-prev]');
  const lbNextBtn = lb?.querySelector<HTMLButtonElement>('[data-lb-next]');
  let lbList: HTMLElement[] = [];
  let lbIndex = -1;
  let loadGen = 0;

  function visibleTiles(): HTMLElement[] {
    return gallery ? Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-photo')) : [];
  }

  function preloadAdjacent(i: number) {
    [i - 1, i + 1].forEach((idx) => {
      if (idx >= 0 && idx < lbList.length) {
        const src = lbList[idx].dataset.photoFull;
        if (src) { const img = new Image(); img.src = src; }
      }
    });
  }

  function updateButtons() {
    if (lbPrevBtn) lbPrevBtn.disabled = lbIndex <= 0;
    if (lbNextBtn) lbNextBtn.disabled = lbIndex >= lbList.length - 1;
  }

  function showAt(i: number) {
    if (!lb || !lbImg) return;
    if (i < 0 || i >= lbList.length) return;
    lbIndex = i;
    const tile = lbList[i];
    const full = tile.dataset.photoFull ?? '';
    const orig = tile.dataset.photoOriginal ?? '';
    const alt = tile.dataset.photoAlt ?? '';

    // Generation guard — prevents a slow high-res load from a previous image
    // overwriting the current one when navigating quickly.
    const gen = ++loadGen;

    lbImg.classList.remove('loaded');
    lbImg.alt = alt;
    lbImg.src = full;
    lbImg.onload = () => {
      if (gen !== loadGen) return;
      lbImg.classList.add('loaded');
      if (orig && orig !== full) {
        const hi = new Image();
        hi.onload = () => {
          if (gen === loadGen) lbImg.src = orig;
        };
        hi.src = orig;
      }
    };

    updateButtons();
    preloadAdjacent(i);
  }

  function openLightbox(tile: HTMLElement) {
    if (!lb) return;
    lbList = visibleTiles();
    lbIndex = lbList.indexOf(tile);
    if (lbIndex < 0) {
      const id = tile.dataset.photoId;
      lbIndex = lbList.findIndex((t) => t.dataset.photoId === id);
      if (lbIndex < 0) lbIndex = 0;
    }
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    showAt(lbIndex);
  }

  function closeLightbox() {
    if (!lb || !lbImg) return;
    lb.hidden = true;
    ++loadGen; // cancel any pending high-res load
    lbImg.removeAttribute('src');
    lbImg.classList.remove('loaded');
    document.body.style.overflow = '';
  }

  function next() { if (lbIndex + 1 < lbList.length) showAt(lbIndex + 1); }
  function prev() { if (lbIndex - 1 >= 0) showAt(lbIndex - 1); }

  // Touch swipe
  let touchStartX = 0;
  let touchStartY = 0;
  lb?.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });
  lb?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
      dx < 0 ? next() : prev();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target) return;
    const tile = target.closest<HTMLElement>('.gallery-photo');
    if (tile) {
      e.preventDefault();
      openLightbox(tile);
      return;
    }
    if (!lb || lb.hidden) return;
    if (target.closest('[data-lb-close]')) {
      closeLightbox();
    } else if (target.closest('[data-lb-next]')) {
      next();
    } else if (target.closest('[data-lb-prev]')) {
      prev();
    } else if (target === lb) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
  });
</script>
