---
import { getGalleryPhotos, publicBase, variantUrl } from '@/lib/photos';
import type { Photo } from '@/lib/photos';

interface Props {
  initial?: number;
}

const { initial = 30 } = Astro.props;
const all = getGalleryPhotos();
const photos = all.slice(0, initial);
const totalCount = all.length;
const hasMore = totalCount > photos.length;
const nextUrl = hasMore ? '/api/photos/1.json' : '';

// Deterministic hash so "wide/featured" picks are stable across renders.
function photoHash(id: string): number {
  let h = 5381;
  for (let i = 0; i < id.length; i++) {
    h = ((h << 5) + h + id.charCodeAt(i)) >>> 0;
  }
  return h;
}
function isWide(photo: Photo): boolean {
  return photoHash(photo.id) % 4 === 0;
}

function buildSrcset(photo: Photo, ext: 'avif' | 'webp'): string {
  return photo.variants[ext]
    .map((w) => `${variantUrl(photo.id, w, ext)} ${w}w`)
    .join(', ');
}

function fallbackSrc(photo: Photo): string {
  const widths = photo.variants.webp;
  return variantUrl(photo.id, widths[0], 'webp');
}

function originalUrl(photo: Photo): string {
  return `${publicBase()}/originals/${photo.id}.${photo.originalExt}`;
}

function fullUrl(photo: Photo): string {
  const widths = photo.variants.webp;
  const w = widths.includes(1600) ? 1600 : widths[widths.length - 1];
  return variantUrl(photo.id, w, 'webp');
}
---

<div class="gallery">
  {photos.map((photo) => {
    // Big/feature treatment: randomly picked, or explicitly highlighted.
    const wide = isWide(photo) || photo.featured;
    const sizes = wide ? '100vw' : '34vw';
    return (
      <picture
        class={`gallery-photo${wide ? ' gallery-photo--wide' : ''}`}
        data-photo-id={photo.id}
        data-photo-original={originalUrl(photo)}
        data-photo-full={fullUrl(photo)}
        data-photo-alt={photo.alt}
        data-photo-ratio={photo.aspectRatio}
      >
        <source type="image/avif" srcset={buildSrcset(photo, 'avif')} sizes={sizes} />
        <source type="image/webp" srcset={buildSrcset(photo, 'webp')} sizes={sizes} />
        <img
          src={fallbackSrc(photo)}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
          style={`background-image: url('${photo.lqip}'); background-size: cover;`}
        />
      </picture>
    );
  })}
</div>

<div id="gallery-sentinel" data-next={nextUrl} aria-hidden="true"></div>

<style is:global>
  .gallery {
    --gallery-gap: 6px;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: 1.5rem;
    padding-inline: 0.5rem;
  }

  /* A justified row: each photo's width is proportional to its aspect ratio
     (flex-grow set in JS). Because width ∝ aspectRatio, the resulting heights
     (width / aspectRatio) come out equal across the row — so the row fills the
     width exactly with no fixed height and, crucially, no cropping. Portrait
     photos simply get a narrower, taller slot that matches their shape. */
  .gallery-row {
    display: flex;
    align-items: flex-start;
    gap: var(--gallery-gap);
    margin-bottom: var(--gallery-gap);
  }
  .gallery-row:last-child {
    margin-bottom: 0;
  }

  .gallery-photo {
    display: block;
    cursor: zoom-in;
    background: var(--color-bg-secondary);
    min-width: 0;
  }
  .gallery-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Pre-JS fallback: a rough flex-wrap grid before the justified layout runs. */
  .gallery:not(.is-justified) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gallery-gap);
  }
  .gallery:not(.is-justified) .gallery-photo {
    flex: 1 1 30%;
  }

  #gallery-sentinel {
    height: 1px;
    width: 100%;
  }
</style>
